{
	"name": "litrpg-hub",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"pipeline": "node --env-file-if-exists=.env --import tsx scripts/backend/index.ts",
		"pipeline:fetch": "npm run pipeline -- fetch",
		"pipeline:export": "node --env-file-if-exists=.env --import tsx scripts/backend/exporters/json.ts",
		"pipeline:classify": "npm run pipeline -- classify",
		"pipeline:build": "npm run pipeline -- build",
		"pipeline:backfill": "npm run pipeline -- backfill",
		"pipeline:enrich": "node --env-file-if-exists=.env --import tsx scripts/backend/jev/enrich.ts",
		"pipeline:covers": "node --env-file-if-exists=.env --import tsx scripts/backend/covers/enrich.ts",
		"pipeline:backup": "node --env-file-if-exists=.env --import tsx scripts/backend/storage/backup.ts",
		"pipeline:series": "node --env-file-if-exists=.env --import tsx scripts/backend/scrape-series.ts",
		"build": "vite build",
		"check:backend": "tsc --project tsconfig.backend.json --noEmit",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"better-sqlite3": "^12.8.0",
		"cheerio": "^1.2.0"
	}
}
