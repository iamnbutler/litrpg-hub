{
	"name": "shelfgoblin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run build:contract && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --exclude '**/.worktrees/**'",
		"test:watch": "vitest --exclude '**/.worktrees/**'",
		"check:worker": "tsc -p tsconfig.worker.json",
		"dev:accounts": "wrangler dev --env local --port 8787",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --env local",
		"db:migrate": "wrangler d1 migrations apply DB --remote",
		"deploy:cloudflare": "BASE_PATH= npm run build && wrangler deploy --env=\"\"",
		"secrets:cloudflare": "node --env-file=.env scripts/cloudflare-secrets.mjs",
		"build:contract": "npm run build --workspace @shelfgoblin/catalog-contract"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260911.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/better-sqlite3": "^7.6.13",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.2",
		"wrangler": "^4.131.1",
		"better-sqlite3": "^12.8.0"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@shelfgoblin/catalog-contract": "1.0.0"
	},
	"workspaces": [
		"packages/catalog-contract"
	]
}
