# Optional static-site subdirectory. Canonical Cloudflare builds use an empty value.
# /litrpg-hub is the historical compatibility path, not the renamed repository path.
BASE_PATH=

# Reader sign-in: server-side only. Upload with npm run secrets:cloudflare.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Also register the exact callback in the GitHub OAuth app.
OAUTH_GITHUB_REDIRECT_URI=https://shelfgobl.in/auth/callback/

# Acquisition, model keys, SQLite paths, and archive settings belong in the private
# shelfgoblin-data checkout. The public scheduled runner uses encrypted repository
# secrets; CATALOG_DATA_TOKEN is a separate private-repository credential, not OAuth.
