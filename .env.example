# Optional. Only read by explicit offline enrichment / fetch commands.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
OPENAI_API_KEY=
CATALOG_OPENAI_MODEL=gpt-5.6-terra
COVER_MODEL=gpt-4.1-mini
# Optional persistent storage paths (relative to the repository or absolute).
CATALOG_DB_PATH=data/books.db
CATALOG_ASSET_DIR=data/covers
HARDCOVER_API_TOKEN=
CATALOG_ARCHIVE_REPO=

# Optional GitHub Pages subdirectory, e.g. /litrpg-hub. Local preview defaults to /.
BASE_PATH=

# Reader sign-in credentials: server-side only; never expose the secret to the static UI.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=https://nate.rip/litrpg-hub/auth/callback/
